# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca é commitado (já está no .gitignore).

# 1. Crie um app em https://developer.spotify.com/dashboard
#    - Em "Redirect URIs", adicione: http://127.0.0.1:3000/api/spotify/callback
#      (e depois, se quiser em produção: https://SEU_DOMINIO/api/spotify/callback)
# 2. Copie o Client ID e o Client Secret do app pra cá:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 3. Com as duas variáveis acima preenchidas, rode `npm run dev`, acesse
#    http://127.0.0.1:3000/api/spotify/login, faça login com sua conta Spotify
#    e autorize. A página de callback vai te mostrar o refresh token — cole aqui:
SPOTIFY_REFRESH_TOKEN=
